"""
@pyne edge

CT-DTM (Ichimoku) — Signal Generator (Live Trading) — v2

تغییرات نسبت به نسخه قبل (مطابق تصمیم‌های کاربر):
  ۱) ورود = سفارش «مارکت» لحظه‌ی تایید کندل (close همان کندل). حد ضرر و تارگت
     بر اساس همان نقطه‌ی ورود محاسبه می‌شوند (نه limit معلق مثل پاین).
  ۴) سیگنال‌های همزمان (مثلاً Anni-L و Aati-L) همگی گزارش می‌شوند:
     an_l_fire / an_s_fire / at_l_fire / at_s_fire  + signal_count
     (کلیدهای signal/entry/stop/target/kind هنوز اولین سیگنال را نشان می‌دهند)
  ۵) برخورد ورود = برخورد اول. برخورد دوم → ریسک‌فری (آنی و آتی).
  ۶) هر دو پوزیشن می‌توانند هم‌زمان باز بمانند (بدون reversal).
  ۷) خروج SL/TP دقیقاً مثل broker emulator تریدینگ‌ویو (مسیر intrabar + گپ).
  ۸) کاتالیزور RSI بدون تغییر.
  ۹) لایو: تمام تغییر state فقط روی کندل بسته‌شده (barstate.isconfirmed) انجام
     می‌شود؛ روی تیک‌های میانی هیچ شمارنده‌ای عوض نمی‌شود و هیچ سیگنالی نمی‌آید.
"""
from pynecore.lib import (
    bar_index, barstate, close, high, input, low, math, na,
    open, script, ta,
)
from pynecore.types import Persistent, Series
import logging

logger = logging.getLogger(__name__)

# ─── گروه‌های ورودی ───
grp_ichi = "ایچیموکو"
grp_logic = "منطق استراتژی CT"
grp_stop = "حد ضرر و تارگت"
grp_rf = "ریسک فری"
grp_filter = "فیلترها"
grp_log = "لاگ تشخیصی"

ANNI_STOP_MID = "Mid-Cloud (وسط ابر)"
ANNI_STOP_FAR = "Far Edge (لبه دور ابر)"
AATI_STOP_SAFE = "Safe (امن)"
AATI_STOP_RISKY = "Risky (ریسکی)"
DIR_BOTH = "هر دو جهت"
DIR_LONG_ONLY = "فقط لانگ"
DIR_SHORT_ONLY = "فقط شورت"


def sim_exit(is_long: bool, o: float, h: float, l: float, sl: float, tp: float):
    """
    شبیه‌سازی broker emulator تریدینگ‌ویو برای strategy.exit(stop=sl, limit=tp) روی یک کندل.

    قوانین:
      • گپ: اگر open از قبل بیرون از SL/TP باشد، خروج با قیمت open انجام می‌شود.
      • مسیر intrabar: اگر (high-open) < (open-low) مسیر O→H→L→C وگرنه O→L→H→C.
      • هر کدام از SL/TP که روی مسیر زودتر لمس شود اجرا می‌شود.

    خروجی: (reason, price) که reason یکی از "SL" / "TP" / "" است.
    """
    if is_long:
        if o <= sl:
            return "SL", o
        if o >= tp:
            return "TP", o
        hit_sl = l <= sl
        hit_tp = h >= tp
        up_first = (h - o) < (o - l)
        if up_first:
            if hit_tp:
                return "TP", tp
            if hit_sl:
                return "SL", sl
        else:
            if hit_sl:
                return "SL", sl
            if hit_tp:
                return "TP", tp
    else:
        if o >= sl:
            return "SL", o
        if o <= tp:
            return "TP", o
        hit_sl = h >= sl
        hit_tp = l <= tp
        up_first = (h - o) < (o - l)
        if up_first:
            if hit_sl:
                return "SL", sl
            if hit_tp:
                return "TP", tp
        else:
            if hit_tp:
                return "TP", tp
            if hit_sl:
                return "SL", sl
    return "", 0.0


@script.strategy(
    "CT-DTM (Ichimoku)",
    shorttitle="CT-Strategy-v3",
    overlay=True,
)
def main(
    # --- ایچیموکو ---
    conversion_periods=input.int(9, "Conversion Periods (Tenkan)", group=grp_ichi),
    base_periods=input.int(26, "Base Periods (Kijun)", group=grp_ichi),
    lagging_span2_periods=input.int(52, "Leading Span B Periods", group=grp_ichi),
    displacement=input.int(26, "Displacement (Cloud Shift)", group=grp_ichi),

    # --- منطق CT ---
    use_wicks_for_exit=input.bool(True, "خروج کامل با احتساب سایه", group=grp_logic),
    exit_consecutive_bars=input.int(1, "کندل بسته‌شده برای تایید خروج", minval=1, maxval=10, group=grp_logic),
    max_anni_candles=input.int(5, "حداکثر کندل برای مدل آنی", minval=1, group=grp_logic),
    aati_min_bars=input.int(3, "حداقل کندل قبل از تست آتی", minval=1, group=grp_logic),
    distance_atr_mult=input.float(1.5, "حداقل فاصله از عبر (ATR)", minval=0.1, step=0.1, group=grp_logic),
    atr_len=input.int(14, "دوره ATR", group=grp_logic),
    enable_crescent_filter=input.bool(True, "فعال‌سازی فیلتر هلال", group=grp_logic),

    # --- حد ضرر / تارگت ---
    anni_stop_mode=input.string(ANNI_STOP_MID, "حد ضرر آنی", options=(ANNI_STOP_MID, ANNI_STOP_FAR), group=grp_stop),
    aati_stop_mode=input.string(AATI_STOP_SAFE, "حد ضرر آتی", options=(AATI_STOP_SAFE, AATI_STOP_RISKY), group=grp_stop),
    safe_buffer_atr_mult=input.float(0.25, "بافر حالت امن (ATR)", minval=0.0, step=0.05, group=grp_stop),
    rr_anni=input.float(7.0, "R:R آنی", minval=0.5, step=0.5, group=grp_stop),
    rr_aati_risky=input.float(10.0, "R:R آتی (ریسکی)", minval=0.5, step=0.5, group=grp_stop),
    rr_aati_safe=input.float(5.0, "R:R آتی (امن)", minval=0.5, step=0.5, group=grp_stop),

    # --- ریسک‌فری ---
    enable_rf_second_touch=input.bool(True, "ریسک‌فری با برخورد دوم", group=grp_rf),
    enable_rf_reversal_candle=input.bool(True, "ریسک‌فری با کندل بازگشتی", group=grp_rf),
    enable_catalyst_filter=input.bool(True, "فعال‌سازی کاتالیزور", group=grp_rf),

    # --- فیلترها ---
    enable_anni=input.bool(True, "فعال‌سازی مدل آنی", group=grp_filter),
    enable_aati=input.bool(True, "فعال‌سازی مدل آتی", group=grp_filter),
    trade_direction=input.string(DIR_BOTH, "جهت مجاز", options=(DIR_BOTH, DIR_LONG_ONLY, DIR_SHORT_ONLY), group=grp_filter),

    # --- لاگ ---
    enable_log=input.bool(True, "لاگ رویدادها", group=grp_log),
):
    # ═══════════════════════════════════════════════════════════
    # 🔵 توابع کمکی
    # ═══════════════════════════════════════════════════════════
    def donchian(src_high: Series[float], src_low: Series[float], length: int) -> Series[float]:
        return (ta.highest(src_high, length) + ta.lowest(src_low, length)) / 2

    def flog(tag: str, msg: str) -> None:
        if enable_log:
            logger.info(f"{tag} | bar={bar_index} | {msg}")

    # OHLC به‌صورت float ساده (برای شبیه‌ساز خروج)
    bar_o: float = open
    bar_h: float = high
    bar_l: float = low
    bar_c: float = close

    confirmed: bool = barstate.isconfirmed

    # ═══════════════════════════════════════════════════════════
    # 🔵 محاسبه ایچیموکو (روی هر تیک/کندل — بدون تغییر)
    # ═══════════════════════════════════════════════════════════
    conversion_line: Series[float] = donchian(high, low, conversion_periods)
    base_line: Series[float] = donchian(high, low, base_periods)
    lead_line1: Series[float] = (conversion_line + base_line) / 2
    lead_line2: Series[float] = donchian(high, low, lagging_span2_periods)

    lead1_disp: Series[float] = lead_line1[displacement]
    lead2_disp: Series[float] = lead_line2[displacement]
    kumo_valid: bool = (not na(lead1_disp)) and (not na(lead2_disp))

    kumo_top: float = na(float)
    kumo_bot: float = na(float)
    if kumo_valid:
        kumo_top = math.max(lead1_disp, lead2_disp)
        kumo_bot = math.min(lead1_disp, lead2_disp)

    atr_val: Series[float] = ta.atr(length=atr_len)

    fully_above_now: bool = False
    fully_below_now: bool = False
    if kumo_valid:
        if use_wicks_for_exit:
            fully_above_now = low > kumo_top
            fully_below_now = high < kumo_bot
        else:
            fully_above_now = math.min(open, close) > kumo_top
            fully_below_now = math.max(open, close) < kumo_bot

    hma20: Series[float] = ta.hma(close, 20)
    hma50: Series[float] = ta.hma(close, 50)
    bullish_crescent: bool = hma20 > hma50 and hma20 > hma20[1] and hma50 > hma50[1]
    bearish_crescent: bool = hma20 < hma50 and hma20 < hma20[1] and hma50 < hma50[1]

    touch_cloud_now: bool = kumo_valid and low <= kumo_top and high >= kumo_bot

    # ═══════════════════════════════════════════════════════════
    # 🔵 الگوهای کندلی + کاتالیزور (بدون تغییر)
    # ═══════════════════════════════════════════════════════════
    def bearish_reversal() -> bool:
        return close < open and close[1] > open[1] and close < open[1] and open > close[1]

    def bullish_reversal() -> bool:
        return close > open and close[1] < open[1] and close > open[1] and open < close[1]

    def catalyst() -> bool:
        r: Series[float] = ta.rsi(source=close, length=14)
        return (close > close[1] and r < r[1]) or (close < close[1] and r > r[1])

    # ═══════════════════════════════════════════════════════════
    # 🔵 State پایدار
    # ═══════════════════════════════════════════════════════════
    consec_above: Persistent[int] = 0
    consec_below: Persistent[int] = 0

    exit_dir: Persistent[str] = ""
    exit_bar: Persistent[int] = -1
    max_distance_atr: Persistent[float] = 0.0
    anni_done: Persistent[bool] = False
    aati_armed: Persistent[bool] = False
    aati_done: Persistent[bool] = False
    exit_number: Persistent[int] = 0

    touch_prev: Persistent[bool] = False

    an_l_pos: Persistent[bool] = False
    an_l_entry: Persistent[float] = na(float)
    an_l_sl: Persistent[float] = na(float)
    an_l_tp: Persistent[float] = na(float)
    an_l_touches: Persistent[int] = 0

    an_s_pos: Persistent[bool] = False
    an_s_entry: Persistent[float] = na(float)
    an_s_sl: Persistent[float] = na(float)
    an_s_tp: Persistent[float] = na(float)
    an_s_touches: Persistent[int] = 0

    at_l_pos: Persistent[bool] = False
    at_l_entry: Persistent[float] = na(float)
    at_l_sl: Persistent[float] = na(float)
    at_l_tp: Persistent[float] = na(float)
    at_l_touches: Persistent[int] = 0

    at_s_pos: Persistent[bool] = False
    at_s_entry: Persistent[float] = na(float)
    at_s_sl: Persistent[float] = na(float)
    at_s_tp: Persistent[float] = na(float)
    at_s_touches: Persistent[int] = 0

    # ═══════════════════════════════════════════════════════════
    # 🔵 خروجی‌های همین اجرا (روی تیک‌های تایید‌نشده همگی خنثی‌اند)
    # ═══════════════════════════════════════════════════════════
    an_l_fire: bool = False
    an_s_fire: bool = False
    at_l_fire: bool = False
    at_s_fire: bool = False

    an_l_exit: str = ""
    an_s_exit: str = ""
    at_l_exit: str = ""
    at_s_exit: str = ""
    an_l_exit_px: float = na(float)
    an_s_exit_px: float = na(float)
    at_l_exit_px: float = na(float)
    at_s_exit_px: float = na(float)

    bars_since_exit: int = -1
    if exit_bar >= 0:
        bars_since_exit = int(bar_index) - exit_bar

    touch_cloud_event: bool = False
    not_stale: bool = True
    anni_long_elig: bool = False
    anni_short_elig: bool = False
    aati_long_elig: bool = False
    aati_short_elig: bool = False

    allow_long: bool = trade_direction != DIR_SHORT_ONLY
    allow_short: bool = trade_direction != DIR_LONG_ONLY

    # ═══════════════════════════════════════════════════════════
    # 🔵 تمام منطق فقط روی کندل بسته‌شده (معادل رفتار Pine)
    # ═══════════════════════════════════════════════════════════
    if confirmed:
        # ─── شمارنده خروج + تشخیص LEG ───
        f_ac: bool = kumo_valid and (
            (low > kumo_top) if use_wicks_for_exit else (math.min(open, close) > kumo_top)
        )
        f_bc: bool = kumo_valid and (
            (high < kumo_bot) if use_wicks_for_exit else (math.max(open, close) < kumo_bot)
        )
        consec_above = consec_above + 1 if f_ac else 0
        consec_below = consec_below + 1 if f_bc else 0

        new_leg_up: bool = (consec_above == exit_consecutive_bars) and (exit_dir != "up")
        new_leg_down: bool = (consec_below == exit_consecutive_bars) and (exit_dir != "down")

        if new_leg_up:
            exit_dir = "up"
            exit_bar = int(bar_index)
            max_distance_atr = 0.0
            anni_done = False
            aati_armed = False
            aati_done = False
            exit_number += 1
            flog("[LEG-UP]", f"leg #{exit_number} confirmed after {consec_above} closed candle(s)")

        if new_leg_down:
            exit_dir = "down"
            exit_bar = int(bar_index)
            max_distance_atr = 0.0
            anni_done = False
            aati_armed = False
            aati_done = False
            exit_number += 1
            flog("[LEG-DOWN]", f"leg #{exit_number} confirmed after {consec_below} closed candle(s)")

        bars_since_exit = -1
        if exit_bar >= 0:
            bars_since_exit = int(bar_index) - exit_bar

        # ─── فاصله از ابر و آماده‌شدن آتی ───
        if (exit_dir != "") and kumo_valid and atr_val > 0:
            cur_dist: float = 0.0
            if exit_dir == "up":
                cur_dist = (low - kumo_top) / atr_val
            else:
                cur_dist = (kumo_bot - high) / atr_val
            max_distance_atr = math.max(max_distance_atr, cur_dist)
            if max_distance_atr >= distance_atr_mult and not aati_armed:
                aati_armed = True
                flog("[AATI-ARMED]", f"maxDistanceATR={max_distance_atr}")

        # ─── برخورد به ابر (لبه‌ی بالارونده) ───
        touch_cloud_event = touch_cloud_now and (not touch_prev)
        if touch_cloud_event:
            flog("[TOUCH]", f"H={bar_h} L={bar_l} kumoTop={kumo_top} kumoBot={kumo_bot}")

        # ─── گارد ضدِ بیات‌شدگی (روی کندل بسته‌شده) ───
        not_stale = not (
            (exit_dir == "down" and fully_above_now) or (exit_dir == "up" and fully_below_now)
        )
        if not not_stale:
            flog("[STALE-GUARD]", f"exitDir={exit_dir} contradicted → no new entries")

        # ─── شرایط واجدشرایط‌بودن ───
        anni_long_elig = (
            enable_anni and allow_long and exit_dir == "up"
            and bars_since_exit >= 0 and bars_since_exit <= max_anni_candles
            and (not anni_done) and not_stale
        )
        anni_short_elig = (
            enable_anni and allow_short and exit_dir == "down"
            and bars_since_exit >= 0 and bars_since_exit <= max_anni_candles
            and (not anni_done) and not_stale
        )
        aati_long_elig = (
            enable_aati and allow_long and exit_dir == "up" and aati_armed
            and bars_since_exit >= aati_min_bars
            and (not aati_done) and not_stale
            and ((not enable_crescent_filter) or bullish_crescent)
        )
        aati_short_elig = (
            enable_aati and allow_short and exit_dir == "down" and aati_armed
            and bars_since_exit >= aati_min_bars
            and (not aati_done) and not_stale
            and ((not enable_crescent_filter) or bearish_crescent)
        )

        # ═══════════════════════════════════════════════════════
        # Anni-L
        # ═══════════════════════════════════════════════════════
        if an_l_pos:
            an_l_exit, an_l_exit_px = sim_exit(True, bar_o, bar_h, bar_l, an_l_sl, an_l_tp)
            if an_l_exit != "":
                an_l_pos = False
                flog("[EXIT]", f"Anni-L {an_l_exit} @ {an_l_exit_px}")
            else:
                if touch_cloud_event:
                    an_l_touches += 1
                if (enable_rf_second_touch and an_l_touches >= 2) or (
                    enable_rf_reversal_candle and bearish_reversal()
                    and ((not enable_catalyst_filter) or catalyst())
                ):
                    if an_l_sl < an_l_entry:
                        flog("[RISK-FREE]", f"Anni-L → breakeven @ {an_l_entry}")
                    an_l_sl = math.max(an_l_sl, an_l_entry)
        elif anni_long_elig and kumo_valid and bar_l <= kumo_top:
            sl_c: float = (kumo_top + kumo_bot) / 2 if anni_stop_mode == ANNI_STOP_MID else kumo_bot
            if bar_c > sl_c:
                an_l_pos = True
                an_l_entry = bar_c
                an_l_sl = sl_c
                an_l_tp = an_l_entry + (an_l_entry - an_l_sl) * rr_anni
                an_l_touches = 1
                anni_done = True
                an_l_fire = True
                flog("[FILL]", f"Anni-L MARKET @ {an_l_entry} SL={an_l_sl} TP={an_l_tp}")
            else:
                flog("[SKIP]", f"Anni-L invalid: close={bar_c} <= SL={sl_c}")

        # ═══════════════════════════════════════════════════════
        # Anni-S
        # ═══════════════════════════════════════════════════════
        if an_s_pos:
            an_s_exit, an_s_exit_px = sim_exit(False, bar_o, bar_h, bar_l, an_s_sl, an_s_tp)
            if an_s_exit != "":
                an_s_pos = False
                flog("[EXIT]", f"Anni-S {an_s_exit} @ {an_s_exit_px}")
            else:
                if touch_cloud_event:
                    an_s_touches += 1
                if (enable_rf_second_touch and an_s_touches >= 2) or (
                    enable_rf_reversal_candle and bullish_reversal()
                    and ((not enable_catalyst_filter) or catalyst())
                ):
                    if an_s_sl > an_s_entry:
                        flog("[RISK-FREE]", f"Anni-S → breakeven @ {an_s_entry}")
                    an_s_sl = math.min(an_s_sl, an_s_entry)
        elif anni_short_elig and kumo_valid and bar_h >= kumo_bot:
            sl_s: float = (kumo_top + kumo_bot) / 2 if anni_stop_mode == ANNI_STOP_MID else kumo_top
            if bar_c < sl_s:
                an_s_pos = True
                an_s_entry = bar_c
                an_s_sl = sl_s
                an_s_tp = an_s_entry - (an_s_sl - an_s_entry) * rr_anni
                an_s_touches = 1
                anni_done = True
                an_s_fire = True
                flog("[FILL]", f"Anni-S MARKET @ {an_s_entry} SL={an_s_sl} TP={an_s_tp}")
            else:
                flog("[SKIP]", f"Anni-S invalid: close={bar_c} >= SL={sl_s}")

        # ═══════════════════════════════════════════════════════
        # Aati-L
        # ═══════════════════════════════════════════════════════
        if at_l_pos:
            at_l_exit, at_l_exit_px = sim_exit(True, bar_o, bar_h, bar_l, at_l_sl, at_l_tp)
            if at_l_exit != "":
                at_l_pos = False
                flog("[EXIT]", f"Aati-L {at_l_exit} @ {at_l_exit_px}")
            else:
                if touch_cloud_event:
                    at_l_touches += 1
                if (enable_rf_second_touch and at_l_touches >= 2) or (
                    enable_rf_reversal_candle and bearish_reversal()
                    and ((not enable_catalyst_filter) or catalyst())
                ):
                    if at_l_sl < at_l_entry:
                        flog("[RISK-FREE]", f"Aati-L → breakeven @ {at_l_entry}")
                    at_l_sl = math.max(at_l_sl, at_l_entry)
        elif aati_long_elig and kumo_valid and bar_l <= kumo_top:
            risky_l: bool = aati_stop_mode == AATI_STOP_RISKY
            cloud_mid_l: float = (kumo_top + kumo_bot) / 2
            sl_al: float = cloud_mid_l if risky_l else kumo_bot - safe_buffer_atr_mult * atr_val
            if bar_c > sl_al:
                rr_al: float = rr_aati_risky if risky_l else rr_aati_safe
                at_l_pos = True
                at_l_entry = bar_c
                at_l_sl = sl_al
                at_l_tp = at_l_entry + (at_l_entry - at_l_sl) * rr_al
                at_l_touches = 1
                aati_done = True
                aati_armed = False
                at_l_fire = True
                flog("[FILL]", f"Aati-L MARKET @ {at_l_entry} SL={at_l_sl} TP={at_l_tp}")
            else:
                flog("[SKIP]", f"Aati-L invalid: close={bar_c} <= SL={sl_al}")

        # ═══════════════════════════════════════════════════════
        # Aati-S
        # ═══════════════════════════════════════════════════════
        if at_s_pos:
            at_s_exit, at_s_exit_px = sim_exit(False, bar_o, bar_h, bar_l, at_s_sl, at_s_tp)
            if at_s_exit != "":
                at_s_pos = False
                flog("[EXIT]", f"Aati-S {at_s_exit} @ {at_s_exit_px}")
            else:
                if touch_cloud_event:
                    at_s_touches += 1
                if (enable_rf_second_touch and at_s_touches >= 2) or (
                    enable_rf_reversal_candle and bullish_reversal()
                    and ((not enable_catalyst_filter) or catalyst())
                ):
                    if at_s_sl > at_s_entry:
                        flog("[RISK-FREE]", f"Aati-S → breakeven @ {at_s_entry}")
                    at_s_sl = math.min(at_s_sl, at_s_entry)
        elif aati_short_elig and kumo_valid and bar_h >= kumo_bot:
            risky_s: bool = aati_stop_mode == AATI_STOP_RISKY
            cloud_mid_s: float = (kumo_top + kumo_bot) / 2
            sl_as: float = cloud_mid_s if risky_s else kumo_top + safe_buffer_atr_mult * atr_val
            if bar_c < sl_as:
                rr_as: float = rr_aati_risky if risky_s else rr_aati_safe
                at_s_pos = True
                at_s_entry = bar_c
                at_s_sl = sl_as
                at_s_tp = at_s_entry - (at_s_sl - at_s_entry) * rr_as
                at_s_touches = 1
                aati_done = True
                aati_armed = False
                at_s_fire = True
                flog("[FILL]", f"Aati-S MARKET @ {at_s_entry} SL={at_s_sl} TP={at_s_tp}")
            else:
                flog("[SKIP]", f"Aati-S invalid: close={bar_c} >= SL={sl_as}")

        # حافظه‌ی برخورد کندل قبل (برای لبه‌ی touch_cloud_event)
        touch_prev = touch_cloud_now

    # ═══════════════════════════════════════════════════════════
    # 🔵 سیگنال اصلی (اولین) + تعداد سیگنال‌های همزمان
    # ═══════════════════════════════════════════════════════════
    fire_kind: str = ""
    fire_dir: str = ""
    fire_entry: float = na(float)
    fire_stop: float = na(float)
    fire_target: float = na(float)

    if an_l_fire:
        fire_kind = "Anni-L"
        fire_dir = "LONG"
        fire_entry = an_l_entry
        fire_stop = an_l_sl
        fire_target = an_l_tp
    elif an_s_fire:
        fire_kind = "Anni-S"
        fire_dir = "SHORT"
        fire_entry = an_s_entry
        fire_stop = an_s_sl
        fire_target = an_s_tp
    elif at_l_fire:
        fire_kind = "Aati-L"
        fire_dir = "LONG"
        fire_entry = at_l_entry
        fire_stop = at_l_sl
        fire_target = at_l_tp
    elif at_s_fire:
        fire_kind = "Aati-S"
        fire_dir = "SHORT"
        fire_entry = at_s_entry
        fire_stop = at_s_sl
        fire_target = at_s_tp

    signal_count: int = 0
    if an_l_fire:
        signal_count += 1
    if an_s_fire:
        signal_count += 1
    if at_l_fire:
        signal_count += 1
    if at_s_fire:
        signal_count += 1

    fire_rr: float = 0.0
    if fire_kind != "":
        risk_main: float = math.abs(fire_entry - fire_stop)
        if risk_main > 0:
            fire_rr = math.abs(fire_target - fire_entry) / risk_main

    # ═══════════════════════════════════════════════════════════
    # 🔵 خروجی dict
    # ═══════════════════════════════════════════════════════════
    return {
        # ─── سیگنال اصلی (اولین سیگنال؛ سازگار با bot.py قبلی) ───
        "signal": fire_dir if fire_kind != "" else None,
        "entry": fire_entry if fire_kind != "" else close,
        "stop": fire_stop,
        "target": fire_target,
        "kind": fire_kind if fire_kind != "" else None,
        "rr": fire_rr,
        "entry_type": "MARKET",
        "confirmed": confirmed,

        # ─── همه‌ی سیگنال‌های همزمان (bot.py باید هر چهار را بخواند) ───
        "signal_count": signal_count,
        "an_l_fire": an_l_fire, "an_s_fire": an_s_fire,
        "at_l_fire": at_l_fire, "at_s_fire": at_s_fire,

        # ─── خروج‌های همین کندل ("" / "SL" / "TP") ───
        "an_l_exit": an_l_exit, "an_l_exit_px": an_l_exit_px if an_l_exit != "" else na(float),
        "an_s_exit": an_s_exit, "an_s_exit_px": an_s_exit_px if an_s_exit != "" else na(float),
        "at_l_exit": at_l_exit, "at_l_exit_px": at_l_exit_px if at_l_exit != "" else na(float),
        "at_s_exit": at_s_exit, "at_s_exit_px": at_s_exit_px if at_s_exit != "" else na(float),

        # ─── وضعیت کانال‌ها ───
        "an_l_pos": an_l_pos, "an_l_entry": an_l_entry, "an_l_sl": an_l_sl, "an_l_tp": an_l_tp,
        "an_s_pos": an_s_pos, "an_s_entry": an_s_entry, "an_s_sl": an_s_sl, "an_s_tp": an_s_tp,
        "at_l_pos": at_l_pos, "at_l_entry": at_l_entry, "at_l_sl": at_l_sl, "at_l_tp": at_l_tp,
        "at_s_pos": at_s_pos, "at_s_entry": at_s_entry, "at_s_sl": at_s_sl, "at_s_tp": at_s_tp,

        # ─── اطلاعات تشخیص ───
        "leg_up": exit_dir == "up",
        "leg_down": exit_dir == "down",
        "exit_dir": exit_dir,
        "exit_number": exit_number,
        "bars_since_exit": bars_since_exit,
        "aati_armed": aati_armed,
        "anni_done": anni_done,
        "aati_done": aati_done,

        "kumo_top": kumo_top,
        "kumo_bot": kumo_bot,
        "kumo_valid": kumo_valid,
        "atr": atr_val,

        "touch_cloud_event": touch_cloud_event,
        "bullish_crescent": bullish_crescent,
        "bearish_crescent": bearish_crescent,
        "not_stale": not_stale,

        "anni_long_elig": anni_long_elig,
        "anni_short_elig": anni_short_elig,
        "aati_long_elig": aati_long_elig,
        "aati_short_elig": aati_short_elig,

        "total_bars_fed": int(bar_index),
    }


if __name__ == "__main__":
    from pynecore.standalone import run
    run(__file__)
