"""
CT-DTM (Ichimoku) strategy — Python port of the Pine Script v6 strategy
=========================================================================

این فایل تلاش می‌کند تا حد امکان منطق پاین‌اسکریپت اصلی را عیناً بازتولید کند:
ابر ایچیموکو (دونچیان-بیس)، تشخیص «لگ خروج از ابر»، مدل‌های ورود «آنی» و
«آتی»، ریسک‌فری، فیلتر هلال (HMA20/50)، و محاسبه حد ضرر/تارگت دقیقاً طبق
همان فرمول‌های پاین.

⚠️ یک نکته‌ی مهم و غیرقابل‌حذف:
موتور strategy.* در TradingView سفارش‌های Limit را به‌صورت intrabar (با مدل
bar-magnifier/تیک داخلی) پر می‌کند. پایتون به چنین موتوری دسترسی ندارد، مگر
اینکه دیتای تیک/تایم‌فریم پایین‌تر در اختیار داشته باشیم. بنابراین همان‌طور
که تقریباً همه‌ی پورت‌های پایتون این کار را انجام می‌دهند، اینجا سفارش Limit
که در کندل i تعیین/به‌روزرسانی می‌شود، در کندل i+1 در صورتی که High/Low آن
کندل به قیمت Limit برسد، پر می‌شود (فرض محافظه‌کارانه و رایج). به همین دلیل
نتایج ۱۰۰٪ بیت‌به‌بیت با بک‌تست TradingView یکسان نخواهد بود، اما تمام منطق
تصمیم‌گیری (ورود/خروج/حد ضرر/تارگت/ریسک‌فری/فیلترها) عیناً همان پاین است.

نیازمندی‌ها: pandas, numpy
ورودی: DataFrame با ستون‌های ['open','high','low','close'] و ایندکس زمانی/عددی
        مرتب صعودی (قدیمی‌ترین کندل اول).
"""

from __future__ import annotations
import math
from dataclasses import dataclass, field
from typing import Optional, List, Dict, Any

import numpy as np
import pandas as pd


# ============================================================
# 🔵 بخش ۱: ورودی‌ها (مطابق input.* در پاین)
# ============================================================
@dataclass
class Inputs:
    # --- ایچیموکو ---
    conversion_periods: int = 9
    base_periods: int = 26
    lagging_span2_periods: int = 52
    displacement: int = 26

    # --- منطق CT ---
    use_wicks_for_exit: bool = True
    exit_consecutive_bars: int = 1
    max_anni_candles: int = 5
    aati_min_bars: int = 3
    distance_atr_mult: float = 1.5
    atr_len: int = 14
    enable_crescent_filter: bool = True

    # --- حد ضرر و تارگت ---
    anni_stop_mode: str = "Mid-Cloud"     # "Mid-Cloud" | "Far Edge"
    aati_stop_mode: str = "Safe"          # "Safe" | "Risky"
    safe_buffer_atr_mult: float = 0.25
    rr_anni: float = 7.0
    rr_aati_risky: float = 10.0
    rr_aati_safe: float = 5.0

    # --- ریسک‌فری ---
    enable_rf_on_second_touch: bool = True
    enable_rf_on_reversal_candle: bool = True
    enable_catalyst_filter: bool = True

    # --- فیلترها ---
    enable_anni: bool = True
    enable_aati: bool = True
    trade_direction: str = "both"          # "both" | "long_only" | "short_only"

    # --- نمایش/سایز (این پورت اندازه‌گیری دلاری را شبیه‌سازی نمی‌کند) ---
    pyramiding: int = 2
    initial_capital: float = 10_000.0
    qty_percent_of_equity: float = 10.0


# ============================================================
# 🔵 بخش ۲: اندیکاتورهای کمکی
# ============================================================
def donchian(high: pd.Series, low: pd.Series, length: int) -> pd.Series:
    hh = high.rolling(length, min_periods=length).max()
    ll = low.rolling(length, min_periods=length).min()
    return (hh + ll) / 2.0


def wma(series: pd.Series, length: int) -> pd.Series:
    weights = np.arange(1, length + 1)

    def _w(x):
        return np.dot(x, weights) / weights.sum()

    return series.rolling(length, min_periods=length).apply(_w, raw=True)


def hma(series: pd.Series, length: int) -> pd.Series:
    half = max(int(length / 2), 1)
    sqrt_len = max(int(round(math.sqrt(length))), 1)
    raw = 2 * wma(series, half) - wma(series, length)
    return wma(raw, sqrt_len)


def rma(series: pd.Series, length: int) -> pd.Series:
    """Wilder's smoothing — همان چیزی که ta.atr / ta.rsi در پاین استفاده می‌کنند."""
    return series.ewm(alpha=1.0 / length, adjust=False, min_periods=length).mean()


def atr(high: pd.Series, low: pd.Series, close: pd.Series, length: int) -> pd.Series:
    prev_close = close.shift(1)
    tr = pd.concat(
        [
            high - low,
            (high - prev_close).abs(),
            (low - prev_close).abs(),
        ],
        axis=1,
    ).max(axis=1)
    return rma(tr, length)


def rsi(close: pd.Series, length: int) -> pd.Series:
    delta = close.diff()
    gain = delta.clip(lower=0.0)
    loss = -delta.clip(upper=0.0)
    avg_gain = rma(gain, length)
    avg_loss = rma(loss, length)
    rs = avg_gain / avg_loss.replace(0, np.nan)
    out = 100 - (100 / (1 + rs))
    out = out.where(avg_loss != 0, 100.0)
    out = out.where(avg_gain != 0, out.where(avg_loss == 0, 0.0))
    return out


# ============================================================
# 🔵 بخش ۳: ساختار معامله / ورودی معلق
# ============================================================
@dataclass
class PendingOrder:
    side: str          # "long" | "short"
    limit_price: float


@dataclass
class OpenTrade:
    entry_id: str
    side: str           # "long" | "short"
    entry_price: float
    sl: float
    tp: float
    touches: int = 0
    entry_bar: int = -1


@dataclass
class ClosedTrade:
    entry_id: str
    side: str
    entry_price: float
    exit_price: float
    entry_bar: int
    exit_bar: int
    exit_reason: str   # "stop" | "target"
    pnl_per_unit: float


@dataclass
class EntrySlot:
    """معادل هر یک از ۴ شناسهٔ ورود در پاین: CT-Anni-L / CT-Anni-S / CT-Aati-L / CT-Aati-S"""
    entry_id: str
    side: str
    pending: Optional[PendingOrder] = None
    open_trade: Optional[OpenTrade] = None


# ============================================================
# 🔵 بخش ۴: موتور اصلی استراتژی
# ============================================================
class CTDTMIchimokuStrategy:
    def __init__(self, df: pd.DataFrame, inputs: Inputs = Inputs()):
        required = {"open", "high", "low", "close"}
        if not required.issubset(df.columns):
            raise ValueError(f"DataFrame باید ستون‌های {required} را داشته باشد")
        self.df = df.reset_index(drop=True).copy()
        self.inp = inputs
        self.log: List[str] = []
        self.closed_trades: List[ClosedTrade] = []
        self._prepare_indicators()
        self._init_state()

    # ---------------------------------------------------------------
    def _log(self, tag: str, msg: str, bar: int) -> None:
        self.log.append(f"{tag} | bar={bar} | {msg}")

    # ---------------------------------------------------------------
    def _prepare_indicators(self) -> None:
        d = self.df
        inp = self.inp

        d["conversion"] = donchian(d.high, d.low, inp.conversion_periods)
        d["base"] = donchian(d.high, d.low, inp.base_periods)
        d["lead1"] = (d["conversion"] + d["base"]) / 2.0
        d["lead2"] = donchian(d.high, d.low, inp.lagging_span2_periods)

        lead1_shift = d["lead1"].shift(inp.displacement)
        lead2_shift = d["lead2"].shift(inp.displacement)
        d["kumo_top"] = pd.concat([lead1_shift, lead2_shift], axis=1).max(axis=1)
        d["kumo_bot"] = pd.concat([lead1_shift, lead2_shift], axis=1).min(axis=1)
        d["kumo_valid"] = d["kumo_top"].notna() & d["kumo_bot"].notna()

        d["atr"] = atr(d.high, d.low, d.close, inp.atr_len)
        d["rsi"] = rsi(d.close, 14)
        d["hma20"] = hma(d.close, 20)
        d["hma50"] = hma(d.close, 50)

        if inp.use_wicks_for_exit:
            full_above = d["kumo_valid"] & (d["low"] > d["kumo_top"])
            full_below = d["kumo_valid"] & (d["high"] < d["kumo_bot"])
        else:
            body_lo = d[["open", "close"]].min(axis=1)
            body_hi = d[["open", "close"]].max(axis=1)
            full_above = d["kumo_valid"] & (body_lo > d["kumo_top"])
            full_below = d["kumo_valid"] & (body_hi < d["kumo_bot"])
        d["full_above"] = full_above
        d["full_below"] = full_below

        d["touch_now"] = d["kumo_valid"] & (d["low"] <= d["kumo_top"]) & (d["high"] >= d["kumo_bot"])
        d["touch_event"] = d["touch_now"] & ~d["touch_now"].shift(1, fill_value=False)

    # ---------------------------------------------------------------
    def _init_state(self) -> None:
        self.exit_dir: Optional[str] = None      # "up" | "down"
        self.exit_bar: Optional[int] = None
        self.max_distance_atr: float = 0.0
        self.anni_done = False
        self.aati_armed = False
        self.aati_done = False
        self.exit_number = 0
        self.consec_above = 0
        self.consec_below = 0

        self.slots: Dict[str, EntrySlot] = {
            "CT-Anni-L": EntrySlot("CT-Anni-L", "long"),
            "CT-Anni-S": EntrySlot("CT-Anni-S", "short"),
            "CT-Aati-L": EntrySlot("CT-Aati-L", "long"),
            "CT-Aati-S": EntrySlot("CT-Aati-S", "short"),
        }

    # ---------------------------------------------------------------
    def _bearish_reversal(self, i: int) -> bool:
        d = self.df
        if i < 1:
            return False
        return (
            d.close[i] < d.open[i]
            and d.close[i - 1] > d.open[i - 1]
            and d.close[i] < d.open[i - 1]
            and d.open[i] > d.close[i - 1]
        )

    def _bullish_reversal(self, i: int) -> bool:
        d = self.df
        if i < 1:
            return False
        return (
            d.close[i] > d.open[i]
            and d.close[i - 1] < d.open[i - 1]
            and d.close[i] > d.open[i - 1]
            and d.open[i] < d.close[i - 1]
        )

    def _catalyst(self, i: int) -> bool:
        d = self.df
        if i < 1 or pd.isna(d.rsi[i]) or pd.isna(d.rsi[i - 1]):
            return False
        if d.close[i] > d.close[i - 1] and d.rsi[i] < d.rsi[i - 1]:
            return True
        if d.close[i] < d.close[i - 1] and d.rsi[i] > d.rsi[i - 1]:
            return True
        return False

    # ---------------------------------------------------------------
    def _fill_pending_orders(self, i: int) -> None:
        """بررسی پر شدن سفارش‌های Limit معلق با High/Low کندل جاری."""
        d = self.df
        for slot in self.slots.values():
            if slot.open_trade is not None or slot.pending is None:
                continue
            p = slot.pending
            hit = (
                d.low[i] <= p.limit_price <= d.high[i]
            )
            if not hit:
                continue
            self._on_fill(slot, i, p.limit_price)
            slot.pending = None

    def _on_fill(self, slot: EntrySlot, i: int, entry_price: float) -> None:
        d = self.df
        inp = self.inp
        kumo_top, kumo_bot, atr_val = d.kumo_top[i], d.kumo_bot[i], d.atr[i]

        if slot.entry_id == "CT-Anni-L":
            sl = (kumo_top + kumo_bot) / 2 if inp.anni_stop_mode.startswith("Mid") else kumo_bot
            tp = entry_price + (entry_price - sl) * inp.rr_anni
            self.anni_done = True
        elif slot.entry_id == "CT-Anni-S":
            sl = (kumo_top + kumo_bot) / 2 if inp.anni_stop_mode.startswith("Mid") else kumo_top
            tp = entry_price - (sl - entry_price) * inp.rr_anni
            self.anni_done = True
        elif slot.entry_id == "CT-Aati-L":
            risky = inp.aati_stop_mode == "Risky"
            cloud_mid = (kumo_top + kumo_bot) / 2
            sl = cloud_mid if risky else kumo_bot - inp.safe_buffer_atr_mult * atr_val
            rr = inp.rr_aati_risky if risky else inp.rr_aati_safe
            tp = entry_price + (entry_price - sl) * rr
            self.aati_done = True
            self.aati_armed = False
        else:  # CT-Aati-S
            risky = inp.aati_stop_mode == "Risky"
            cloud_mid = (kumo_top + kumo_bot) / 2
            sl = cloud_mid if risky else kumo_top + inp.safe_buffer_atr_mult * atr_val
            rr = inp.rr_aati_risky if risky else inp.rr_aati_safe
            tp = entry_price - (sl - entry_price) * rr
            self.aati_done = True
            self.aati_armed = False

        slot.open_trade = OpenTrade(
            entry_id=slot.entry_id, side=slot.side,
            entry_price=entry_price, sl=sl, tp=tp, touches=0, entry_bar=i,
        )
        self._log("[FILL]", f"{slot.entry_id} @ {entry_price:.5f} SL={sl:.5f} TP={tp:.5f}", i)

    # ---------------------------------------------------------------
    def _manage_open_trades(self, i: int) -> None:
        d = self.df
        inp = self.inp
        for slot in self.slots.values():
            t = slot.open_trade
            if t is None:
                continue

            if d.touch_event[i]:
                t.touches += 1

            # --- ریسک‌فری ---
            catalyst_ok = (not inp.enable_catalyst_filter) or self._catalyst(i)
            if t.side == "long":
                reversal = self._bearish_reversal(i)
                rf_trigger = (inp.enable_rf_on_second_touch and t.touches >= 2) or (
                    inp.enable_rf_on_reversal_candle and reversal and catalyst_ok
                )
                if rf_trigger:
                    if t.sl < t.entry_price:
                        self._log("[RISK-FREE]", f"{slot.entry_id} moved to breakeven @ {t.entry_price:.5f}", i)
                    t.sl = max(t.sl, t.entry_price)
            else:
                reversal = self._bullish_reversal(i)
                rf_trigger = (inp.enable_rf_on_second_touch and t.touches >= 2) or (
                    inp.enable_rf_on_reversal_candle and reversal and catalyst_ok
                )
                if rf_trigger:
                    if t.sl > t.entry_price:
                        self._log("[RISK-FREE]", f"{slot.entry_id} moved to breakeven @ {t.entry_price:.5f}", i)
                    t.sl = min(t.sl, t.entry_price)

            # --- بررسی خروج (Stop / Target) ---
            hi, lo = d.high[i], d.low[i]
            if t.side == "long":
                hit_sl = lo <= t.sl
                hit_tp = hi >= t.tp
            else:
                hit_sl = hi >= t.sl
                hit_tp = lo <= t.tp

            if hit_sl and hit_tp:
                # فرض محافظه‌کارانه: اگر هر دو در یک کندل لمس شوند، ابتدا حد ضرر
                exit_price, reason = t.sl, "stop"
            elif hit_sl:
                exit_price, reason = t.sl, "stop"
            elif hit_tp:
                exit_price, reason = t.tp, "target"
            else:
                continue

            pnl = (exit_price - t.entry_price) if t.side == "long" else (t.entry_price - exit_price)
            self.closed_trades.append(
                ClosedTrade(
                    entry_id=t.entry_id, side=t.side, entry_price=t.entry_price,
                    exit_price=exit_price, entry_bar=t.entry_bar, exit_bar=i,
                    exit_reason=reason, pnl_per_unit=pnl,
                )
            )
            self._log("[EXIT]", f"{t.entry_id} {reason} @ {exit_price:.5f} pnl/unit={pnl:.5f}", i)
            slot.open_trade = None

    # ---------------------------------------------------------------
    def _update_leg_state(self, i: int) -> None:
        """بخش ۴/۵ پاین: تشخیص خروج کامل کندل بسته‌شده و لگ جدید."""
        d = self.df
        inp = self.inp

        full_above = bool(d.full_above[i]) if d.kumo_valid[i] else False
        full_below = bool(d.full_below[i]) if d.kumo_valid[i] else False

        self.consec_above = self.consec_above + 1 if full_above else 0
        self.consec_below = self.consec_below + 1 if full_below else 0

        new_leg_up = self.consec_above == inp.exit_consecutive_bars and self.exit_dir != "up"
        new_leg_down = self.consec_below == inp.exit_consecutive_bars and self.exit_dir != "down"

        if new_leg_up:
            self.exit_dir = "up"
            self.exit_bar = i
            self.max_distance_atr = 0.0
            self.anni_done = False
            self.aati_armed = False
            self.aati_done = False
            self.exit_number += 1
            self._log("[LEG-UP]", f"leg #{self.exit_number} confirmed", i)

        if new_leg_down:
            self.exit_dir = "down"
            self.exit_bar = i
            self.max_distance_atr = 0.0
            self.anni_done = False
            self.aati_armed = False
            self.aati_done = False
            self.exit_number += 1
            self._log("[LEG-DOWN]", f"leg #{self.exit_number} confirmed", i)

        # فاصله از ابر برای آرم کردن آتی
        if self.exit_dir is not None and d.kumo_valid[i] and d.atr[i] and d.atr[i] > 0:
            if self.exit_dir == "up":
                cur_dist = (d.low[i] - d.kumo_top[i]) / d.atr[i]
            else:
                cur_dist = (d.kumo_bot[i] - d.high[i]) / d.atr[i]
            self.max_distance_atr = max(self.max_distance_atr, cur_dist)
            if self.max_distance_atr >= inp.distance_atr_mult and not self.aati_armed:
                self.aati_armed = True
                self._log("[AATI-ARMED]", f"maxDistanceATR={self.max_distance_atr:.3f}", i)

    # ---------------------------------------------------------------
    def _eligibility(self, i: int) -> Dict[str, bool]:
        d = self.df
        inp = self.inp

        bars_since_exit = (i - self.exit_bar) if self.exit_bar is not None else None
        not_stale = not (
            (self.exit_dir == "down" and bool(d.full_above[i]))
            or (self.exit_dir == "up" and bool(d.full_below[i]))
        )

        allow_long = inp.trade_direction != "short_only"
        allow_short = inp.trade_direction != "long_only"

        bullish_crescent = bool(
            d.hma20[i] > d.hma50[i] and d.hma20[i] > d.hma20[i - 1] and d.hma50[i] > d.hma50[i - 1]
        ) if i >= 1 and not pd.isna(d.hma20[i - 1]) and not pd.isna(d.hma50[i - 1]) else False
        bearish_crescent = bool(
            d.hma20[i] < d.hma50[i] and d.hma20[i] < d.hma20[i - 1] and d.hma50[i] < d.hma50[i - 1]
        ) if i >= 1 and not pd.isna(d.hma20[i - 1]) and not pd.isna(d.hma50[i - 1]) else False

        anni_long = (
            inp.enable_anni and allow_long and self.exit_dir == "up"
            and bars_since_exit is not None and 0 <= bars_since_exit <= inp.max_anni_candles
            and not self.anni_done and not_stale
        )
        anni_short = (
            inp.enable_anni and allow_short and self.exit_dir == "down"
            and bars_since_exit is not None and 0 <= bars_since_exit <= inp.max_anni_candles
            and not self.anni_done and not_stale
        )
        aati_long = (
            inp.enable_aati and allow_long and self.exit_dir == "up" and self.aati_armed
            and bars_since_exit is not None and bars_since_exit >= inp.aati_min_bars
            and not self.aati_done and not_stale
            and (not inp.enable_crescent_filter or bullish_crescent)
        )
        aati_short = (
            inp.enable_aati and allow_short and self.exit_dir == "down" and self.aati_armed
            and bars_since_exit is not None and bars_since_exit >= inp.aati_min_bars
            and not self.aati_done and not_stale
            and (not inp.enable_crescent_filter or bearish_crescent)
        )
        return {
            "CT-Anni-L": anni_long, "CT-Anni-S": anni_short,
            "CT-Aati-L": aati_long, "CT-Aati-S": aati_short,
        }

    # ---------------------------------------------------------------
    def _place_or_cancel_orders(self, i: int, elig: Dict[str, bool]) -> None:
        d = self.df
        for entry_id, slot in self.slots.items():
            if slot.open_trade is not None:
                continue
            limit_price = d.kumo_top[i] if slot.side == "long" else d.kumo_bot[i]
            if elig[entry_id] and not pd.isna(limit_price):
                slot.pending = PendingOrder(side=slot.side, limit_price=float(limit_price))
            else:
                slot.pending = None

    # ---------------------------------------------------------------
    def run(self) -> pd.DataFrame:
        n = len(self.df)
        for i in range(n):
            if i > 0:
                self._fill_pending_orders(i)
            self._manage_open_trades(i)
            self._update_leg_state(i)
            elig = self._eligibility(i)
            self._place_or_cancel_orders(i, elig)

        return self.trades_dataframe()

    # --------------------------------------------------------------
    def trades_dataframe(self) -> pd.DataFrame:
        rows = [t.__dict__ for t in self.closed_trades]
        return pd.DataFrame(rows)


