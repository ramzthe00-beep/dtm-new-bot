"""
@pyne edge

CT-DTM (Ichimoku) — نسخه‌ی بومی PyneCore، بازنویسی‌شده مطابق قراردادهای
واقعیِ خروجی کامپایلر PyneComp (که خود شما نمونه‌اش را فرستادید: فایل
DTM Divergence Light). موارد زیر مستقیماً از آن نمونه‌ی واقعی استخراج و
اینجا اعمال شده‌اند (نه حدس):

  • Persistent/Series از pynecore.types می‌آیند، نه از pynecore مستقیم.
  • ماژول log وجود ندارد؛ لاگ با logging استاندارد پایتون انجام می‌شود
    (logger = logging.getLogger(__name__)).
  • na(float) / na(str) هم برای مقداردهی اولیه‌ی persistent (معادل var x = na
    در پاین) و هم برای تستِ NA بودن (not na(x)) استفاده می‌شود — نه None/is None.
  • input.string(..., options=(...)) با tuple، نه list.
  • ta.rsi(source=..., length=...) و ta.atr(length=...) با keyword arg؛
    ta.highest/ta.lowest/ta.sma به‌صورت positional.
  • ایندکس‌گذاری روی یک Series (مثل high[n]) خودش یک Series شیفت‌خورده
    برمی‌گرداند و می‌شود مستقیم به تابع ta.* دیگری داد.
  • متغیرهایی که در دو شاخه‌ی if/else مقداردهی می‌شوند، از قبل با نوع
    صریح اعلام می‌شوند (result: bool = False ...).

⚠️ همچنان یک نکته‌ی صادقانه باقی می‌ماند: strategy.entry/strategy.exit و
strategy.opentrades در نمونه‌ی واقعی‌ای که فرستادید استفاده نشده بودند (آن
اسکریپت فقط سیگنال تولید می‌کرد، معامله باز نمی‌کرد)، پس امضای دقیق این‌ها
هنوز از یک منبعِ کامپایل‌شده‌ی واقعی تأیید نشده. این‌جا بر اساس هم‌نامی با
خودِ Pine نوشته شده‌اند (که فلسفه‌ی طراحی PyneCore دقیقاً همین است). اگر
pyne run روی همین بخش خطا داد، خطا را بفرستید تا دقیقاً اصلاح شود.

تغییر خواسته‌شده‌ی شما نسبت به پاین اصلی: ورود دیگر Limit در kumoTop/kumoBot
نیست؛ به‌محض برخورد قیمت با ابر (واجدشرایط‌شدن روی کندل بسته‌شده)
strategy.entry بدون limit/stop صادر می‌شود = سفارش مارکت.
"""
from pynecore.lib import (
    bar_index, close, color, high, input, low, math, na,
    open, script, strategy, ta,
)
from pynecore.types import Persistent, Series
import logging

logger = logging.getLogger(__name__)

# ============================================================
# نام گروه‌های ورودی
# ============================================================
grp_ichi = "ایچیموکو"
grp_logic = "منطق استراتژی CT"
grp_stop = "حد ضرر و تارگت"
grp_rf = "ریسک فری"
grp_filter = "فیلترها"
grp_log = "لاگ تشخیصی"

# گزینه‌های input.string — به‌صورت ثابت تعریف می‌شوند تا مقایسه‌ی == دقیق باشد
ANNI_STOP_MID = "Mid-Cloud (وسط ابر)"
ANNI_STOP_FAR = "Far Edge (لبه دور ابر)"
AATI_STOP_SAFE = "Safe (امن)"
AATI_STOP_RISKY = "Risky (ریسکی)"
DIR_BOTH = "هر دو جهت"
DIR_LONG_ONLY = "فقط لانگ"
DIR_SHORT_ONLY = "فقط شورت"


@script.strategy(
    "CT-DTM (Ichimoku)",
    shorttitle="CT-Strategy-v3",
    overlay=True,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=10,
    calc_on_every_tick=True,
    pyramiding=2,
    initial_capital=10000,
)
def main(
    # --- ایچیموکو ---
    conversion_periods=input.int(9, "Conversion Periods (Tenkan)", group=grp_ichi),
    base_periods=input.int(26, "Base Periods (Kijun)", group=grp_ichi),
    lagging_span2_periods=input.int(52, "Leading Span B Periods", group=grp_ichi),
    displacement=input.int(26, "Displacement (Cloud Shift)", group=grp_ichi),

    # --- منطق CT ---
    use_wicks_for_exit=input.bool(True, "خروج کامل با احتساب سایه (Wick)؟", group=grp_logic),
    exit_consecutive_bars=input.int(1, "تعداد کندل کامل بسته‌شده برای تایید خروج", minval=1, maxval=10, group=grp_logic),
    max_anni_candles=input.int(5, "حداکثر تعداد کندل برای مدل آنی", minval=1, group=grp_logic),
    aati_min_bars=input.int(3, "حداقل تعداد کندل قبل از تست آتی (پروکسی هلال)", minval=1, group=grp_logic),
    distance_atr_mult=input.float(1.5, "حداقل فاصله از عبر (ضریب ATR) برای اعتبار آتی", minval=0.1, step=0.1, group=grp_logic),
    atr_len=input.int(14, "دوره ATR", group=grp_logic),
    enable_crescent_filter=input.bool(True, "فعال‌سازی فیلتر هلال برای مدل آتی", group=grp_logic),

    # --- حد ضرر / تارگت ---
    anni_stop_mode=input.string(ANNI_STOP_MID, "حالت حد ضرر مدل آنی", options=(ANNI_STOP_MID, ANNI_STOP_FAR), group=grp_stop),
    aati_stop_mode=input.string(AATI_STOP_SAFE, "حالت حد ضرر مدل آتی", options=(AATI_STOP_SAFE, AATI_STOP_RISKY), group=grp_stop),
    safe_buffer_atr_mult=input.float(0.25, "بافر اضافه برای حالت امن (ضریب ATR)", minval=0.0, step=0.05, group=grp_stop),
    rr_anni=input.float(7.0, "ریسک به ریوارد - مدل آنی", minval=0.5, step=0.5, group=grp_stop),
    rr_aati_risky=input.float(10.0, "ریسک به ریوارد - آتی (ریسکی)", minval=0.5, step=0.5, group=grp_stop),
    rr_aati_safe=input.float(5.0, "ریسک به ریوارد - آتی (امن)", minval=0.5, step=0.5, group=grp_stop),

    # --- ریسک‌فری ---
    enable_rf_second_touch=input.bool(True, "ریسک‌فری با برخورد دوم به عبر", group=grp_rf),
    enable_rf_reversal_candle=input.bool(True, "ریسک‌فری با کندل بازگشتی", group=grp_rf),
    enable_catalyst_filter=input.bool(True, "فعال‌سازی کاتالیزور (RSI Divergence Proxy)", group=grp_rf),

    # --- فیلترها ---
    enable_anni=input.bool(True, "فعال‌سازی مدل آنی", group=grp_filter),
    enable_aati=input.bool(True, "فعال‌سازی مدل آتی", group=grp_filter),
    trade_direction=input.string(DIR_BOTH, "جهت مجاز معامله", options=(DIR_BOTH, DIR_LONG_ONLY, DIR_SHORT_ONLY), group=grp_filter),

    # --- لاگ ---
    enable_log=input.bool(True, "فعال‌سازی لاگ رویدادها", group=grp_log),
):
    # ============================================================
    # 🔵 توابع کمکی محلی
    # ============================================================
    def donchian(src_high: Series[float], src_low: Series[float], length: int) -> float:
        return (ta.highest(src_high, length) + ta.lowest(src_low, length)) / 2

    def flog(tag: str, msg: str) -> None:
        if enable_log:
            logger.info(f"{tag} | bar={bar_index} | {msg}")

    # ============================================================
    # 🔵 محاسبه ایچیموکو
    # ============================================================
    conversion_line: Series[float] = donchian(high, low, conversion_periods)
    base_line: Series[float] = donchian(high, low, base_periods)
    lead_line1: Series[float] = (conversion_line + base_line) / 2
    lead_line2: Series[float] = donchian(high, low, lagging_span2_periods)

    # kumoTop/kumoBot = مقادیر lead_line1/2 از displacement کندل قبل
    lead1_disp = lead_line1[displacement]
    lead2_disp = lead_line2[displacement]
    kumo_valid: bool = (not na(lead1_disp)) and (not na(lead2_disp))

    kumo_top: float = na(float)
    kumo_bot: float = na(float)
    if kumo_valid:
        kumo_top = math.max(lead1_disp, lead2_disp)
        kumo_bot = math.min(lead1_disp, lead2_disp)

    atr_val: Series[float] = ta.atr(length=atr_len)

    full_above_now: bool = False
    full_below_now: bool = False
    if kumo_valid:
        if use_wicks_for_exit:
            full_above_now = low > kumo_top
            full_below_now = high < kumo_bot
        else:
            full_above_now = math.min(open, close) > kumo_top
            full_below_now = math.max(open, close) < kumo_bot

    # ============================================================
    # 🔵 State پایدار (معادل var در پاین)
    # ============================================================
    consec_above: Persistent[int] = 0
    consec_below: Persistent[int] = 0
    consec_above = consec_above + 1 if full_above_now else 0
    consec_below = consec_below + 1 if full_below_now else 0

    exit_dir: Persistent[str] = na(str)
    exit_bar: Persistent[float] = na(float)      # float چون باید بتواند na باشد
    max_distance_atr: Persistent[float] = 0.0
    anni_done: Persistent[bool] = False
    aati_armed: Persistent[bool] = False
    aati_done: Persistent[bool] = False
    exit_number: Persistent[int] = 0

    new_leg_up = consec_above == exit_consecutive_bars and exit_dir != "up"
    new_leg_down = consec_below == exit_consecutive_bars and exit_dir != "down"

    if new_leg_up:
        exit_dir = "up"
        exit_bar = float(bar_index)
        max_distance_atr = 0.0
        anni_done = False
        aati_armed = False
        aati_done = False
        exit_number += 1
        flog("[LEG-UP]", f"leg #{exit_number} confirmed after {consec_above} closed candle(s)")

    if new_leg_down:
        exit_dir = "down"
        exit_bar = float(bar_index)
        max_distance_atr = 0.0
        anni_done = False
        aati_armed = False
        aati_done = False
        exit_number += 1
        flog("[LEG-DOWN]", f"leg #{exit_number} confirmed after {consec_below} closed candle(s)")

    bars_since_exit: float = na(float)
    if not na(exit_bar):
        bars_since_exit = bar_index - exit_bar

    if (not na(exit_dir)) and kumo_valid and atr_val > 0:
        cur_dist: float = 0.0
        if exit_dir == "up":
            cur_dist = (low - kumo_top) / atr_val
        else:
            cur_dist = (kumo_bot - high) / atr_val
        max_distance_atr = math.max(max_distance_atr, cur_dist)
        if max_distance_atr >= distance_atr_mult and not aati_armed:
            aati_armed = True
            flog("[AATI-ARMED]", f"maxDistanceATR={max_distance_atr}")

    # ============================================================
    # 🔵 برخورد با ابر + فیلتر هلال (HMA) + گارد ضدِ بیات‌شدگی
    # ============================================================
    touch_cloud_now: bool = kumo_valid and low <= kumo_top and high >= kumo_bot
    touch_cloud_event: bool = touch_cloud_now and not touch_cloud_now[1]

    hma20: Series[float] = ta.hma(close, 20)
    hma50: Series[float] = ta.hma(close, 50)
    bullish_crescent: bool = hma20 > hma50 and hma20 > hma20[1] and hma50 > hma50[1]
    bearish_crescent: bool = hma20 < hma50 and hma20 < hma20[1] and hma50 < hma50[1]

    not_stale: bool = not (
        (exit_dir == "down" and full_above_now) or (exit_dir == "up" and full_below_now)
    )

    # ============================================================
    # 🔵 واجدشرایط‌بودن
    # ============================================================
    allow_long: bool = trade_direction != DIR_SHORT_ONLY
    allow_short: bool = trade_direction != DIR_LONG_ONLY

    anni_long_elig: bool = (
        enable_anni and allow_long and exit_dir == "up"
        and (not na(bars_since_exit)) and 0 <= bars_since_exit <= max_anni_candles
        and (not anni_done) and not_stale
    )
    anni_short_elig: bool = (
        enable_anni and allow_short and exit_dir == "down"
        and (not na(bars_since_exit)) and 0 <= bars_since_exit <= max_anni_candles
        and (not anni_done) and not_stale
    )
    aati_long_elig: bool = (
        enable_aati and allow_long and exit_dir == "up" and aati_armed
        and (not na(bars_since_exit)) and bars_since_exit >= aati_min_bars
        and (not aati_done) and not_stale
        and ((not enable_crescent_filter) or bullish_crescent)
    )
    aati_short_elig: bool = (
        enable_aati and allow_short and exit_dir == "down" and aati_armed
        and (not na(bars_since_exit)) and bars_since_exit >= aati_min_bars
        and (not aati_done) and not_stale
        and ((not enable_crescent_filter) or bearish_crescent)
    )

    # ============================================================
    # 🔵 الگوی کندل / کاتالیزور
    # ============================================================
    def bearish_reversal() -> bool:
        return close < open and close[1] > open[1] and close < open[1] and open > close[1]

    def bullish_reversal() -> bool:
        return close > open and close[1] < open[1] and close > open[1] and open < close[1]

    def catalyst() -> bool:
        r: Series[float] = ta.rsi(source=close, length=14)
        return (close > close[1] and r < r[1]) or (close < close[1] and r > r[1])

    def entry_open(entry_id: str) -> bool:
        found: bool = False
        for i in range(strategy.opentrades):
            if strategy.opentrades.entry_id(i) == entry_id:
                found = True
        return found

    def entry_price_of(entry_id: str) -> float:
        price: float = na(float)
        for i in range(strategy.opentrades):
            if strategy.opentrades.entry_id(i) == entry_id:
                price = strategy.opentrades.entry_price(i)
        return price

    # ============================================================
    # 🔵 ورود مارکت به‌محض برخورد با ابر + مدیریت پوزیشن
    #    (بدون limit/stop در strategy.entry = سفارش مارکت)
    # ============================================================
    an_l_sl: Persistent[float] = na(float)
    an_l_tp: Persistent[float] = na(float)
    an_l_entry: Persistent[float] = na(float)
    an_l_touches: Persistent[int] = 0

    if entry_open("CT-Anni-L"):
        if na(an_l_entry):
            an_l_entry = entry_price_of("CT-Anni-L")
            an_l_sl = (kumo_top + kumo_bot) / 2 if anni_stop_mode == ANNI_STOP_MID else kumo_bot
            an_l_tp = an_l_entry + (an_l_entry - an_l_sl) * rr_anni
            an_l_touches = 0
            anni_done = True
            flog("[FILL]", f"Anni-L @ {an_l_entry} SL={an_l_sl} TP={an_l_tp}")
        if touch_cloud_event:
            an_l_touches += 1
        if (enable_rf_second_touch and an_l_touches >= 2) or (
            enable_rf_reversal_candle and bearish_reversal() and ((not enable_catalyst_filter) or catalyst())
        ):
            an_l_sl = math.max(an_l_sl, an_l_entry)
        strategy.exit("CT-Anni-L-X", from_entry="CT-Anni-L", stop=an_l_sl, limit=an_l_tp)
    else:
        an_l_entry = na(float)
        if anni_long_elig:
            strategy.entry("CT-Anni-L", strategy.long)   # مارکت
        else:
            strategy.cancel("CT-Anni-L")

    an_s_sl: Persistent[float] = na(float)
    an_s_tp: Persistent[float] = na(float)
    an_s_entry: Persistent[float] = na(float)
    an_s_touches: Persistent[int] = 0

    if entry_open("CT-Anni-S"):
        if na(an_s_entry):
            an_s_entry = entry_price_of("CT-Anni-S")
            an_s_sl = (kumo_top + kumo_bot) / 2 if anni_stop_mode == ANNI_STOP_MID else kumo_top
            an_s_tp = an_s_entry - (an_s_sl - an_s_entry) * rr_anni
            an_s_touches = 0
            anni_done = True
            flog("[FILL]", f"Anni-S @ {an_s_entry} SL={an_s_sl} TP={an_s_tp}")
        if touch_cloud_event:
            an_s_touches += 1
        if (enable_rf_second_touch and an_s_touches >= 2) or (
            enable_rf_reversal_candle and bullish_reversal() and ((not enable_catalyst_filter) or catalyst())
        ):
            an_s_sl = math.min(an_s_sl, an_s_entry)
        strategy.exit("CT-Anni-S-X", from_entry="CT-Anni-S", stop=an_s_sl, limit=an_s_tp)
    else:
        an_s_entry = na(float)
        if anni_short_elig:
            strategy.entry("CT-Anni-S", strategy.short)  # مارکت
        else:
            strategy.cancel("CT-Anni-S")

    at_l_sl: Persistent[float] = na(float)
    at_l_tp: Persistent[float] = na(float)
    at_l_entry: Persistent[float] = na(float)
    at_l_touches: Persistent[int] = 0

    if entry_open("CT-Aati-L"):
        if na(at_l_entry):
            risky: bool = aati_stop_mode == AATI_STOP_RISKY
            cloud_mid: float = (kumo_top + kumo_bot) / 2
            at_l_entry = entry_price_of("CT-Aati-L")
            at_l_sl = cloud_mid if risky else kumo_bot - safe_buffer_atr_mult * atr_val
            rr: float = rr_aati_risky if risky else rr_aati_safe
            at_l_tp = at_l_entry + (at_l_entry - at_l_sl) * rr
            at_l_touches = 0
            aati_done = True
            aati_armed = False
            flog("[FILL]", f"Aati-L @ {at_l_entry} SL={at_l_sl} TP={at_l_tp}")
        if touch_cloud_event:
            at_l_touches += 1
        if (enable_rf_second_touch and at_l_touches >= 2) or (
            enable_rf_reversal_candle and bearish_reversal() and ((not enable_catalyst_filter) or catalyst())
        ):
            at_l_sl = math.max(at_l_sl, at_l_entry)
        strategy.exit("CT-Aati-L-X", from_entry="CT-Aati-L", stop=at_l_sl, limit=at_l_tp)
    else:
        at_l_entry = na(float)
        if aati_long_elig:
            strategy.entry("CT-Aati-L", strategy.long)   # مارکت
        else:
            strategy.cancel("CT-Aati-L")

    at_s_sl: Persistent[float] = na(float)
    at_s_tp: Persistent[float] = na(float)
    at_s_entry: Persistent[float] = na(float)
    at_s_touches: Persistent[int] = 0

    if entry_open("CT-Aati-S"):
        if na(at_s_entry):
            risky: bool = aati_stop_mode == AATI_STOP_RISKY
            cloud_mid: float = (kumo_top + kumo_bot) / 2
            at_s_entry = entry_price_of("CT-Aati-S")
            at_s_sl = cloud_mid if risky else kumo_top + safe_buffer_atr_mult * atr_val
            rr: float = rr_aati_risky if risky else rr_aati_safe
            at_s_tp = at_s_entry - (at_s_sl - at_s_entry) * rr
            at_s_touches = 0
            aati_done = True
            aati_armed = False
            flog("[FILL]", f"Aati-S @ {at_s_entry} SL={at_s_sl} TP={at_s_tp}")
        if touch_cloud_event:
            at_s_touches += 1
        if (enable_rf_second_touch and at_s_touches >= 2) or (
            enable_rf_reversal_candle and bullish_reversal() and ((not enable_catalyst_filter) or catalyst())
        ):
            at_s_sl = math.min(at_s_sl, at_s_entry)
        strategy.exit("CT-Aati-S-X", from_entry="CT-Aati-S", stop=at_s_sl, limit=at_s_tp)
    else:
        at_s_entry = na(float)
        if aati_short_elig:
            strategy.entry("CT-Aati-S", strategy.short)  # مارکت
        else:
            strategy.cancel("CT-Aati-S")


if __name__ == "__main__":
    from pynecore.standalone import run
    run(__file__)
