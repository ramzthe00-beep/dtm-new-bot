"""
@pyne
"""
"""
CT-DTM (Ichimoku) — نسخه‌ی بومی PyneCore
==========================================

⚠️ توضیح مهم و صادقانه:
این فایل مستقیماً روی نصب PyneCore شما اجرا/تست نشده (چون PyneCore در sandbox
من نصب نیست). ساختار و نام توابع بر اساس هم‌خوانی مستندِ PyneCore با فضای
نام‌گذاری خودِ Pine Script نوشته شده (ta.*, input.*, strategy.*, Persistent,
Series) — یعنی فرض بر این است که PyneCore دقیقاً همان امضاهای Pine را
پیاده‌سازی کرده. منطق (شرط‌ها، فرمول‌ها، ترتیب اجرا) ۱۰۰٪ همان پاین است.
اگر با `pyne run` خطایی گرفتید (مثلاً نام تابعی فرق دارد یا امضای input
متفاوت است)، خطا را برایم بفرستید تا دقیقاً همان‌جا را اصلاح کنم — این تنها
راه واقعی برای رسیدن به تطابق ۱۰۰٪ تضمین‌شده است.

تغییر خواسته‌شده‌ی شما نسبت به پاین اصلی:
ورودها دیگر Limit در kumoTop/kumoBot نیستند؛ به‌محض برخورد قیمت با ابر
(یعنی واجدشرایط‌شدن Anni/Aati روی کندل بسته‌شده) strategy.entry() به‌صورت
مارکت (بدون limit/stop) صادر می‌شود — دقیقاً رفتار خواسته‌شده‌ی شما.
"""

from pynecore import Persistent, Series
from pynecore.lib import (
    script, ta, math, input, strategy, log,
    close, open, high, low, bar_index,
    color, na, str as pine_str,
)


# ============================================================
# 🔵 استراتژی
# ============================================================
@script.strategy(
    "CT-DTM (Ichimoku)",
    shorttitle="CT-Strategy-v3",
    overlay=True,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=10,
    calc_on_every_tick=True,
    pyramiding=2,
    initial_capital=10000,
)
def main(
    # --- ایچیموکو ---
    conversion_periods: int = input.int(9, "Conversion Periods (Tenkan)", group="ایچیموکو"),
    base_periods: int = input.int(26, "Base Periods (Kijun)", group="ایچیموکو"),
    lagging_span2_periods: int = input.int(52, "Leading Span B Periods", group="ایچیموکو"),
    displacement: int = input.int(26, "Displacement (Cloud Shift)", group="ایچیموکو"),

    # --- منطق CT ---
    use_wicks_for_exit: bool = input.bool(True, "خروج کامل با احتساب سایه (Wick)؟", group="منطق استراتژی CT"),
    exit_consecutive_bars: int = input.int(1, "تعداد کندل کامل بسته‌شده برای تایید خروج", minval=1, maxval=10, group="منطق استراتژی CT"),
    max_anni_candles: int = input.int(5, "حداکثر تعداد کندل برای مدل آنی", minval=1, group="منطق استراتژی CT"),
    aati_min_bars: int = input.int(3, "حداقل تعداد کندل قبل از تست آتی (پروکسی هلال)", minval=1, group="منطق استراتژی CT"),
    distance_atr_mult: float = input.float(1.5, "حداقل فاصله از عبر (ضریب ATR) برای اعتبار آتی", minval=0.1, step=0.1, group="منطق استراتژی CT"),
    atr_len: int = input.int(14, "دوره ATR", group="منطق استراتژی CT"),
    enable_crescent_filter: bool = input.bool(True, "فعال‌سازی فیلتر هلال برای مدل آتی", group="منطق استراتژی CT"),

    # --- حد ضرر / تارگت ---
    anni_stop_mode: str = input.string("Mid-Cloud (وسط ابر)", "حالت حد ضرر مدل آنی", options=["Mid-Cloud (وسط ابر)", "Far Edge (لبه دور ابر)"], group="حد ضرر و تارگت"),
    aati_stop_mode: str = input.string("Safe (امن)", "حالت حد ضرر مدل آتی", options=["Safe (امن)", "Risky (ریسکی)"], group="حد ضرر و تارگت"),
    safe_buffer_atr_mult: float = input.float(0.25, "بافر اضافه برای حالت امن (ضریب ATR)", minval=0.0, step=0.05, group="حد ضرر و تارگت"),
    rr_anni: float = input.float(7.0, "ریسک به ریوارد - مدل آنی", minval=0.5, step=0.5, group="حد ضرر و تارگت"),
    rr_aati_risky: float = input.float(10.0, "ریسک به ریوارد - آتی (ریسکی)", minval=0.5, step=0.5, group="حد ضرر و تارگت"),
    rr_aati_safe: float = input.float(5.0, "ریسک به ریوارد - آتی (امن)", minval=0.5, step=0.5, group="حد ضرر و تارگت"),

    # --- ریسک‌فری ---
    enable_rf_second_touch: bool = input.bool(True, "ریسک‌فری با برخورد دوم به عبر", group="ریسک فری"),
    enable_rf_reversal_candle: bool = input.bool(True, "ریسک‌فری با کندل بازگشتی", group="ریسک فری"),
    enable_catalyst_filter: bool = input.bool(True, "فعال‌سازی کاتالیزور (RSI Divergence Proxy)", group="ریسک فری"),

    # --- فیلترها ---
    enable_anni: bool = input.bool(True, "فعال‌سازی مدل آنی", group="فیلترها"),
    enable_aati: bool = input.bool(True, "فعال‌سازی مدل آتی", group="فیلترها"),
    trade_direction: str = input.string("هر دو جهت", "جهت مجاز معامله", options=["هر دو جهت", "فقط لانگ", "فقط شورت"], group="فیلترها"),

    # --- لاگ ---
    enable_log: bool = input.bool(True, "فعال‌سازی لاگ رویدادها", group="لاگ تشخیصی"),
):
    # ============================================================
    # 🔵 توابع کمکی محلی
    # ============================================================
    def donchian(src_high: Series[float], src_low: Series[float], length: int) -> float:
        return (ta.highest(src_high, length) + ta.lowest(src_low, length)) / 2

    def f_log(tag: str, msg: str) -> None:
        if enable_log:
            log.info(f"{tag} | bar={bar_index} | {msg}")

    # ============================================================
    # 🔵 محاسبه ایچیموکو
    # ============================================================
    conversion_line = donchian(high, low, conversion_periods)
    base_line = donchian(high, low, base_periods)
    lead_line1 = (conversion_line + base_line) / 2
    lead_line2 = donchian(high, low, lagging_span2_periods)

    # kumoTop/kumoBot = مقادیر lead_line1/2 از displacement کندل قبل (تاریخ‌محور، نه شیفت به جلو)
    lead1_disp = lead_line1[displacement]
    lead2_disp = lead_line2[displacement]
    kumo_valid = not na(lead1_disp) and not na(lead2_disp)
    kumo_top = math.max(lead1_disp, lead2_disp) if kumo_valid else float("nan")
    kumo_bot = math.min(lead1_disp, lead2_disp) if kumo_valid else float("nan")

    atr_val = ta.atr(atr_len)

    if use_wicks_for_exit:
        full_above_now = kumo_valid and low > kumo_top
        full_below_now = kumo_valid and high < kumo_bot
    else:
        full_above_now = kumo_valid and math.min(open, close) > kumo_top
        full_below_now = kumo_valid and math.max(open, close) < kumo_bot

    # ============================================================
    # 🔵 State پایدار (معادل var در پاین)
    # ============================================================
    consec_above: Persistent[int] = 0
    consec_below: Persistent[int] = 0

    consec_above = consec_above + 1 if full_above_now else 0
    consec_below = consec_below + 1 if full_below_now else 0

    exit_dir: Persistent[str] = None
    exit_bar: Persistent[int] = None
    max_distance_atr: Persistent[float] = 0.0
    anni_done: Persistent[bool] = False
    aati_armed: Persistent[bool] = False
    aati_done: Persistent[bool] = False
    exit_number: Persistent[int] = 0

    new_leg_up = consec_above == exit_consecutive_bars and exit_dir != "up"
    new_leg_down = consec_below == exit_consecutive_bars and exit_dir != "down"

    if new_leg_up:
        exit_dir = "up"
        exit_bar = bar_index
        max_distance_atr = 0.0
        anni_done = False
        aati_armed = False
        aati_done = False
        exit_number += 1
        f_log("[LEG-UP]", f"leg #{exit_number} confirmed after {consec_above} closed candle(s)")

    if new_leg_down:
        exit_dir = "down"
        exit_bar = bar_index
        max_distance_atr = 0.0
        anni_done = False
        aati_armed = False
        aati_done = False
        exit_number += 1
        f_log("[LEG-DOWN]", f"leg #{exit_number} confirmed after {consec_below} closed candle(s)")

    bars_since_exit = None if exit_bar is None else bar_index - exit_bar

    if exit_dir is not None and kumo_valid and atr_val > 0:
        cur_dist = (low - kumo_top) / atr_val if exit_dir == "up" else (kumo_bot - high) / atr_val
        max_distance_atr = math.max(max_distance_atr, cur_dist)
        if max_distance_atr >= distance_atr_mult and not aati_armed:
            aati_armed = True
            f_log("[AATI-ARMED]", f"maxDistanceATR={max_distance_atr}")

    # ============================================================
    # 🔵 برخورد با ابر + فیلتر هلال (HMA) + گارد ضدِ بیات‌شدگی
    # ============================================================
    touch_cloud_now = kumo_valid and low <= kumo_top and high >= kumo_bot
    touch_cloud_event = touch_cloud_now and not touch_cloud_now[1]

    hma20 = ta.hma(close, 20)
    hma50 = ta.hma(close, 50)
    bullish_crescent = hma20 > hma50 and hma20 > hma20[1] and hma50 > hma50[1]
    bearish_crescent = hma20 < hma50 and hma20 < hma20[1] and hma50 < hma50[1]

    not_stale = not (
        (exit_dir == "down" and full_above_now) or (exit_dir == "up" and full_below_now)
    )

    # ============================================================
    # 🔵 واجدشرایط‌بودن
    # ============================================================
    allow_long = trade_direction != "فقط شورت"
    allow_short = trade_direction != "فقط لانگ"

    anni_long_elig = (
        enable_anni and allow_long and exit_dir == "up"
        and bars_since_exit is not None and 0 <= bars_since_exit <= max_anni_candles
        and not anni_done and not_stale
    )
    anni_short_elig = (
        enable_anni and allow_short and exit_dir == "down"
        and bars_since_exit is not None and 0 <= bars_since_exit <= max_anni_candles
        and not anni_done and not_stale
    )
    aati_long_elig = (
        enable_aati and allow_long and exit_dir == "up" and aati_armed
        and bars_since_exit is not None and bars_since_exit >= aati_min_bars
        and not aati_done and not_stale
        and (not enable_crescent_filter or bullish_crescent)
    )
    aati_short_elig = (
        enable_aati and allow_short and exit_dir == "down" and aati_armed
        and bars_since_exit is not None and bars_since_exit >= aati_min_bars
        and not aati_done and not_stale
        and (not enable_crescent_filter or bearish_crescent)
    )

    # ============================================================
    # 🔵 توابع الگوی کندل / کاتالیزور
    # ============================================================
    def bearish_reversal() -> bool:
        return close < open and close[1] > open[1] and close < open[1] and open > close[1]

    def bullish_reversal() -> bool:
        return close > open and close[1] < open[1] and close > open[1] and open < close[1]

    def catalyst() -> bool:
        r = ta.rsi(close, 14)
        return (close > close[1] and r < r[1]) or (close < close[1] and r > r[1])

    def entry_open(entry_id: str) -> bool:
        for i in range(strategy.opentrades):
            if strategy.opentrades.entry_id(i) == entry_id:
                return True
        return False

    def entry_price(entry_id: str) -> float:
        for i in range(strategy.opentrades):
            if strategy.opentrades.entry_id(i) == entry_id:
                return strategy.opentrades.entry_price(i)
        return float("nan")

    # ============================================================
    # 🔵 ورود مارکت به‌محض برخورد با ابر (طبق درخواست شما) + مدیریت پوزیشن
    #    توجه: دیگر limit=kumoTop/kumoBot نداریم — strategy.entry بدون
    #    limit/stop یعنی سفارش مارکت، که در Open کندل بعد پر می‌شود.
    # ============================================================
    an_l_sl: Persistent[float] = None
    an_l_tp: Persistent[float] = None
    an_l_entry: Persistent[float] = None
    an_l_touches: Persistent[int] = 0

    if entry_open("CT-Anni-L"):
        if an_l_entry is None:
            an_l_entry = entry_price("CT-Anni-L")
            an_l_sl = (kumo_top + kumo_bot) / 2 if anni_stop_mode.startswith("Mid") else kumo_bot
            an_l_tp = an_l_entry + (an_l_entry - an_l_sl) * rr_anni
            an_l_touches = 0
            anni_done = True
            f_log("[FILL]", f"Anni-L @ {an_l_entry} SL={an_l_sl} TP={an_l_tp}")
        if touch_cloud_event:
            an_l_touches += 1
        if (enable_rf_second_touch and an_l_touches >= 2) or (
            enable_rf_reversal_candle and bearish_reversal() and (not enable_catalyst_filter or catalyst())
        ):
            an_l_sl = math.max(an_l_sl, an_l_entry)
        strategy.exit("CT-Anni-L-X", from_entry="CT-Anni-L", stop=an_l_sl, limit=an_l_tp)
    else:
        an_l_entry = None
        if anni_long_elig:
            strategy.entry("CT-Anni-L", strategy.long)   # مارکت
        else:
            strategy.cancel("CT-Anni-L")

    an_s_sl: Persistent[float] = None
    an_s_tp: Persistent[float] = None
    an_s_entry: Persistent[float] = None
    an_s_touches: Persistent[int] = 0

    if entry_open("CT-Anni-S"):
        if an_s_entry is None:
            an_s_entry = entry_price("CT-Anni-S")
            an_s_sl = (kumo_top + kumo_bot) / 2 if anni_stop_mode.startswith("Mid") else kumo_top
            an_s_tp = an_s_entry - (an_s_sl - an_s_entry) * rr_anni
            an_s_touches = 0
            anni_done = True
            f_log("[FILL]", f"Anni-S @ {an_s_entry} SL={an_s_sl} TP={an_s_tp}")
        if touch_cloud_event:
            an_s_touches += 1
        if (enable_rf_second_touch and an_s_touches >= 2) or (
            enable_rf_reversal_candle and bullish_reversal() and (not enable_catalyst_filter or catalyst())
        ):
            an_s_sl = math.min(an_s_sl, an_s_entry)
        strategy.exit("CT-Anni-S-X", from_entry="CT-Anni-S", stop=an_s_sl, limit=an_s_tp)
    else:
        an_s_entry = None
        if anni_short_elig:
            strategy.entry("CT-Anni-S", strategy.short)  # مارکت
        else:
            strategy.cancel("CT-Anni-S")

    at_l_sl: Persistent[float] = None
    at_l_tp: Persistent[float] = None
    at_l_entry: Persistent[float] = None
    at_l_touches: Persistent[int] = 0

    if entry_open("CT-Aati-L"):
        if at_l_entry is None:
            risky = aati_stop_mode == "Risky (ریسکی)"
            cloud_mid = (kumo_top + kumo_bot) / 2
            at_l_entry = entry_price("CT-Aati-L")
            at_l_sl = cloud_mid if risky else kumo_bot - safe_buffer_atr_mult * atr_val
            rr = rr_aati_risky if risky else rr_aati_safe
            at_l_tp = at_l_entry + (at_l_entry - at_l_sl) * rr
            at_l_touches = 0
            aati_done = True
            aati_armed = False
            f_log("[FILL]", f"Aati-L @ {at_l_entry} SL={at_l_sl} TP={at_l_tp}")
        if touch_cloud_event:
            at_l_touches += 1
        if (enable_rf_second_touch and at_l_touches >= 2) or (
            enable_rf_reversal_candle and bearish_reversal() and (not enable_catalyst_filter or catalyst())
        ):
            at_l_sl = math.max(at_l_sl, at_l_entry)
        strategy.exit("CT-Aati-L-X", from_entry="CT-Aati-L", stop=at_l_sl, limit=at_l_tp)
    else:
        at_l_entry = None
        if aati_long_elig:
            strategy.entry("CT-Aati-L", strategy.long)   # مارکت
        else:
            strategy.cancel("CT-Aati-L")

    at_s_sl: Persistent[float] = None
    at_s_tp: Persistent[float] = None
    at_s_entry: Persistent[float] = None
    at_s_touches: Persistent[int] = 0

    if entry_open("CT-Aati-S"):
        if at_s_entry is None:
            risky = aati_stop_mode == "Risky (ریسکی)"
            cloud_mid = (kumo_top + kumo_bot) / 2
            at_s_entry = entry_price("CT-Aati-S")
            at_s_sl = cloud_mid if risky else kumo_top + safe_buffer_atr_mult * atr_val
            rr = rr_aati_risky if risky else rr_aati_safe
            at_s_tp = at_s_entry - (at_s_sl - at_s_entry) * rr
            at_s_touches = 0
            aati_done = True
            aati_armed = False
            f_log("[FILL]", f"Aati-S @ {at_s_entry} SL={at_s_sl} TP={at_s_tp}")
        if touch_cloud_event:
            at_s_touches += 1
        if (enable_rf_second_touch and at_s_touches >= 2) or (
            enable_rf_reversal_candle and bullish_reversal() and (not enable_catalyst_filter or catalyst())
        ):
            at_s_sl = math.min(at_s_sl, at_s_entry)
        strategy.exit("CT-Aati-S-X", from_entry="CT-Aati-S", stop=at_s_sl, limit=at_s_tp)
    else:
        at_s_entry = None
        if aati_short_elig:
            strategy.entry("CT-Aati-S", strategy.short)  # مارکت
        else:
            strategy.cancel("CT-Aati-S")
